# ==============================================================================
# CronFlow — Root Environment Example (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API (@cronflow/api)
# ------------------------------------------------------------------------------

# Runtime environment: "development" | "test" | "production"
# - "development" & "test" use SQLite by default
# - "production" requires a PostgreSQL connection string in DATABASE_URL
NODE_ENV=development

# HTTP Server bind address and port
HOST=0.0.0.0
PORT=3333

# Database connection:
# Development / Test (SQLite file path or ":memory:"):
DATABASE_URL=./data/cronflow.db
# Production (PostgreSQL connection URL - required when NODE_ENV=production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cronflow

# Secret key used to sign and verify JWT tokens (must be >= 32 chars and non-default in production)
JWT_SECRET=cronflow-super-secret-jwt-key-2026

# SSRF Protection: allow or block webhook calls to localhost / private IPs
# Defaults to "true" in development/test and "false" in production
ALLOW_PRIVATE_NETWORKS=true

# Allowed CORS Origin (in dev defaults to true; in prod defaults to false or specify allowed origin)
# CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Web (@cronflow/web)
# ------------------------------------------------------------------------------

# Base URL for the Fastify HTTP API
VITE_API_URL=http://localhost:3333

# Donation settings displayed in the sidebar modal and /docs page
VITE_DONATION_PIX_KEY=your-pix-key
VITE_DONATION_SPONSOR_URL=https://github.com/sponsors/danieldsg
