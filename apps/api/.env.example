# ==============================================================================
# @cronflow/api — Environment Variables
# ==============================================================================

# "development" | "test" (SQLite) | "production" (PostgreSQL)
NODE_ENV=development

HOST=0.0.0.0
PORT=3333

# SQLite (development / test)
DATABASE_URL=./data/cronflow.db

# PostgreSQL (production — required when NODE_ENV=production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cronflow

# Secret key used to sign and verify JWT tokens (must be >= 32 chars and non-default in production)
JWT_SECRET=cronflow-super-secret-jwt-key-2026

# SSRF Protection: allow or block webhook calls to localhost / private IPs
# Defaults to "true" in development/test and "false" in production
ALLOW_PRIVATE_NETWORKS=true

# Allowed CORS Origin (in dev defaults to true; in prod defaults to false or specify allowed origin)
# CORS_ORIGIN=http://localhost:5173
